<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#C8000000" />
            <corners android:radius="20dp"/>
        </shape>
    </item>
    <item android:left="0.5dp" android:top="0.5dp" android:right="0.5dp" android:bottom="0.5dp">
        <shape android:shape="rectangle">
            <stroke android:width="2dp" android:color="#ecd184" />
            <corners android:radius="15dp"/>
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp">
        <shape android:shape="rectangle">
            <stroke android:width="2.5dp" android:color="#ecd184" />
            <corners android:radius="10dp"/>
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</layer-list>